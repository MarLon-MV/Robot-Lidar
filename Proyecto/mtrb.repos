# Third-party sources built inside this workspace (not available as Jazzy apt packages).
#   vcs import src < mtrb.repos
repositories:
  ldlidar_stl_ros2:
    type: git
    url: https://github.com/ldrobotSensorTeam/ldlidar_stl_ros2.git
    version: master
  m-explore-ros2:
    # Autonomous frontier exploration (explore_lite + explore_lite_msgs), used by explore:=true.
    type: git
    url: https://github.com/robo-friends/m-explore-ros2.git
    version: main
